# Documented blind spots (SECURITY.md). Each must NOT be reported yet; when the
# analysis catches one, turn its annotation into `expect`.
@public("corpus")
route GET "/m2" -> str!:
    # other external input: a file's or an HTTP response's contents used as a path
    target = std::fs::read_to_string("/srv/next.txt")?
    ret std::fs::read_to_string(target.trim())?  # known-miss: path-traversal
