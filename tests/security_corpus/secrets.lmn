# Secret leaks and hard-coded credentials.
state:
    api_token: str = env("API_TOKEN", "")  # expect: secret-type
    signing_key: Secret = env_secret("SIGNING_KEY")?
    db_password: Secret = secret("hunter2-but-longer")  # expect: hardcoded-secret
    webhook: Secret = env_secret("WEBHOOK_SECRET")?

const STRIPE: str = "sk_live_51HxQ2abcdefghijklmnop"  # expect: hardcoded-secret

@public("corpus")
route GET "/leak" (state) -> str!:
    print(state.signing_key.expose())  # expect: secret-exposure
    log_info("key {state.signing_key.expose()}")  # expect: secret-exposure
    fail(500, "bad key {state.webhook.expose()}")  # expect: secret-exposure
    shown = "token={state.webhook.expose()}"  # expect: secret-exposure
    log_info("key is {state.signing_key}")
    ok = state.signing_key.matches("candidate")
    password = "correct horse battery staple"  # expect: hardcoded-secret
    ret "ok"
