# Deep call chain: request data passes through 100 functions before reaching the sink.
# Guards the fixed-point analysis against depth limits (an earlier version stopped at 32 rounds).

fn f100(p: &str) -> str!:
    ret std::fs::read_to_string(p)?

fn f99(p: &str) -> str!:
    ret f100(p)

