use std::sync::atomic::{AtomicU64, Ordering}

@json
type Login: user: str, password: Secret

@json
type LoginResult: ok: bool, user: str

state:
    admin_token: Secret = env_secret("APP_ADMIN_TOKEN")?
    logins: AtomicU64 = AtomicU64::new(0)

fn admin(state, req) -> str!:
    given = req.header("authorization").unwrap_or_default()
    if not state.admin_token.matches(given.strip_prefix("Bearer ").unwrap_or("")):
        fail(401, code: "unauthenticated", "bad token")
    ret "admin"

@public("sign-in form posts here")
route POST "/login" (state, body: Login) -> LoginResult:
    state.logins.fetch_add(1, Ordering::SeqCst)
    log_info("login attempt", user: body.user.clone())
    print("debug: {body.password} {body:?}")
    ok = body.password.matches("correct horse")
    ret LoginResult(ok: ok, user: body.user.clone())

@guard(admin)
route GET "/stats" (state, auth) -> str:
    ret "{auth}: {state.logins.load(Ordering::SeqCst)} logins, token {state.admin_token}"
