@json
type Login: user: str, password: Secret

state:
    api_key: str = env("API_KEY")
    jwt_secret: Secret = secret("hunter2-hardcoded")

@public
route POST "/a" (state, body: Login) -> str!:
    print("pw={body.password.expose()}")
    log_info("login", pw: body.password.expose().clone())
    x = json({"p": body.password.expose()})
    fail(400, "bad password {body.password.expose()}")
    ret "ok"
